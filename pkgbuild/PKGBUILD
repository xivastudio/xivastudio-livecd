pkgname=xivastudio-livecd
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('GPL')
depends=('biglinux-livecd')
url="https://github.com/xivastudio/$pkgname"
pkgdesc="XivaStudio custom logo for live CD boot wizard"
source=("git+https://github.com/xivastudio/$pkgname.git")
md5sums=(SKIP)
install=post.install

package() {
    cp -r "${srcdir}/$pkgname/usr/" "${pkgdir}/"
}
